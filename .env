# 【通用】环境变量

# 版本号
VITE_VERSION = 1.0.0

# 端口号（三端并行：运营后台 3006 / 管理后台 3007 / boss-h5 3008）
VITE_PORT = 3008

# 应用部署基础路径（开发为 /，生产见 .env.production）
VITE_BASE_URL = /

# 是否使用本地 mock 数据（true=不依赖后端，页面交互可独立跑通）
VITE_USE_MOCK = true

# 店铺识别模式：appid 参数/请求头传递（与 管理后台 一致）
VITE_APP_MODE = appid

# appid 模式默认店铺ID（登录页可改）
VITE_DEFAULT_APPID = 10001
